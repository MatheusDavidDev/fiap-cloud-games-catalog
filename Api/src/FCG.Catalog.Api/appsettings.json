{
  "Redis": {
    "ConnectionString": "localhost:6379"
  },

  "MongoDb": {
    "DatabaseName": "Catalogo"
  },

  "OpenSearch": {
    "Url": "http://localhost:9200"
  },

  "Jwt": {
    "ExpiresHours": 12
  },

  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "MassTransit": "Information",
        "Microsoft.Extensions.Caching.StackExchangeRedis": "Information",
        "StackExchange.Redis": "Information"
      }
    }
  },

  "AllowedHosts": "*"
}
